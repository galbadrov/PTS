# Supabase Dashboard > Project Settings > Database > Connect
# Runtime: Supavisor Transaction pooler (port 6543).
# Pri Transaction načinu dodaj pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Prisma CLI/migracije: Direct connection (port 5432).
# Če omrežje nima IPv6, lahko uporabiš Supavisor Session pooler na portu 5432.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Neobvezno: Supabase JS odjemalec (publishable key je lahko javna vrednost).
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

