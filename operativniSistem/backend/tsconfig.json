{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["index.ts", "utils/**/*.ts", "scripts/**/*.ts", "prisma/**/*.ts", "generated/**/*.ts", "prisma.config.ts"]
}

